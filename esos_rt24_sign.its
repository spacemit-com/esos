/dts-v1/;

/ {
	description = "Signed ESOS dual-core image for K3";
	#address-cells = <2>;

	images {
		rcpu0-fw {
			description = "ESOS Core0";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0x200000>;
			entry = <0x1 0x200000>;
			data = /incbin/("../output/esos/rt24_os0_rcpu.elf");
			hash {
				algo = "sha256";
			};
		};

		rcpu1-fw {
			description = "ESOS Core1";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0x804000>;
			entry = <0x1 0x804000>;
			data = /incbin/("../output/esos/rt24_os1_rcpu.elf");
			hash {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "conf_dual";
		conf_dual {
			description = "ESOS Dual Core Configuration";
			loadables = "rcpu0-fw", "rcpu1-fw";
			signature-1 {
				algo = "sha256,rsa2048";
				key-name-hint = "uboot_key_prv";
				sign-images = "loadables";
			};
		};
	};
};
