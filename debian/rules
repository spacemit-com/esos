#!/usr/bin/make -f
# Debian rules file for ESOS

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE = 1

# Set environment variables for the build
export TOP_DIR = $(CURDIR)
export TOP_BSP_DIR = $(TOP_DIR)/bsp/spacemit
export TOP_ESOS_BASE_DEFCONF = $(TOP_BSP_DIR)/.esos_top.config
export TOP_CROSS_COMPILE=riscv64-unknown-elf-

# Native vs cross detection (same idea as opensbi/debian/rules).
# The payload compiler is riscv64-unknown-elf-gcc (newlib / bare-metal):
#   - native (bianbu riscv64): system gcc-riscv64-unknown-elf + prebuilt newlib
#   - cross  (x86_64 container): bundled x86_64 toolchain (ships its own newlib)
#
# The prebuilt newlib travels as debian/lib.tar.gz and is handed to the linker
# via -L: the cross gcc ignores LIBRARY_PATH, and copying the archives into
# /usr/lib/gcc/... requires root, which PPA builders do not have.
DEB_HOST_ARCH  ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
DEB_BUILD_ARCH ?= $(shell dpkg-architecture -qDEB_BUILD_ARCH)
ifeq ($(DEB_HOST_ARCH),$(DEB_BUILD_ARCH))
RTT_EXEC_PATH = /usr/bin
EXTRA_LFLAGS = -L$(TOP_DIR)/debian/lib
else
RTT_EXEC_PATH = $(TOP_DIR)/tools/toolchain/spacemit-toolchain-elf-newlib-x86_64-v1.0.9/bin
# The bundled toolchain ships its own newlib; no extra -L needed.
EXTRA_LFLAGS =
endif

# get the commit ID
GIT_INSIDE := $(shell git rev-parse --is-inside-work-tree 2>/dev/null)
ifeq ($(GIT_INSIDE),true)
	COMMIT_ID := $(shell git rev-parse --short HEAD)
endif

%:
	dh $@

override_dh_auto_configure:
	# Create base configuration for k3_all_cores
	echo "export TOP_TARGET_CHIP=rt24" > $(TOP_ESOS_BASE_DEFCONF)
	touch ${TOP_BSP_DIR}/rtconfig.h

override_dh_gencontrol:
	# Same convention as opensbi-spacemit / u-boot-spacemit: debian/control
	# declares XBS-Commit-Id as a misc:CommitId substitution variable, and the
	# value is supplied here.
	echo "misc:CommitId=$(COMMIT_ID)" >> debian/esos-spacemit.substvars
	dh_gencontrol

override_dh_auto_build:
	# Use the build.sh script to build the project.
	# KEY_DIR controls signing:
	#   - set   → build_top.sh uses the signed ITS (sha256,rsa2048) and runs
	#             mkimage -k $(KEY_DIR) -r to produce a signed esos.itb.
	#   - empty → unsigned ITB (crc32 only).
	#
	# Invocation examples:
	#   Signed:   KEY_DIR=/path/to/keys dpkg-buildpackage -b -us -uc
	#   Unsigned: dpkg-buildpackage -b -us -uc
	#
	# Unpack the prebuilt libraries (shipped as a tarball because dpkg-source
	# excludes *.a by default when building source packages).
	rm -rf $(TOP_DIR)/debian/lib
	tar -xzf $(TOP_DIR)/debian/lib.tar.gz -C $(TOP_DIR)/debian/
	EXTRA_LFLAGS="$(EXTRA_LFLAGS)" \
	TOP_OUTPUT_DIR=$(TOP_DIR)/output/esos RTT_EXEC_PATH=$(RTT_EXEC_PATH) KEY_DIR=$(KEY_DIR) $(TOP_DIR)/build_top.sh

override_dh_auto_clean:
	# Clean build artifacts
	if [ -f $(TOP_DIR)/$(TOP_ESOS_BASE_DEFCONF) ]; then \
		$(TOP_DIR)/build.sh clean || true; \
	fi
	rm -f $(TOP_ESOS_BASE_DEFCONF)
	rm -f $(TOP_BSP_DIR)/*.itb $(TOP_BSP_DIR)/*.elf $(TOP_BSP_DIR)/*.bin
	rm -f $(TOP_BSP_DIR)/platform/rt24/*.dtb
	rm -rf $(TOP_DIR)/output/esos
	rm -rf $(TOP_DIR)/debian/lib

override_dh_makeshlibs:
	# ESOS is bare-metal firmware; nothing to register as a shared library.

override_dh_shlibdeps:
	# The .elf payloads are static bare-metal images with no shared-lib deps;
	# skip scanning so dh does not need a riscv64-linux-gnu-objdump.
